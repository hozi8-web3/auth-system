# ============================================
# ENTERPRISE AUTH SERVER - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# ============================================
# SERVER
# ============================================

# NODE_ENV - Environment mode
# Options:
#   - development  : Enables verbose logging, detailed error messages, hot reload
#   - production   : Optimized for performance, minimal logging, no stack traces in errors
#   - test         : Used for running automated tests
#   - staging      : Pre-production environment for final testing
NODE_ENV=development

# Port the server listens on
PORT=3000

# API version prefix
API_VERSION=v1

# Base URL for the API (used in emails, redirects, etc.)
API_BASE_URL=http://localhost:3000

# ============================================
# DATABASE (PostgreSQL)
# ============================================

# Full database connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db?schema=public

# Individual database settings (used by Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auth_db
POSTGRES_PORT=5432

# ============================================
# REDIS
# ============================================

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis password (leave empty for no auth in development)
REDIS_PASSWORD=

# Redis port (used by Docker)
REDIS_PORT=6379

# ============================================
# JWT
# ============================================

# Access token expiry
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: 15m, 1h, 30s
JWT_ACCESS_TOKEN_EXPIRY=15m

# Refresh token expiry
JWT_REFRESH_TOKEN_EXPIRY=7d

# JWT issuer (your domain)
JWT_ISSUER=auth.example.com

# JWT audience (who the token is intended for)
JWT_AUDIENCE=api.example.com

# RSA Key Paths (generate with: npm run generate:keys)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# ============================================
# PASSWORD SECURITY (Argon2id)
# ============================================
# OWASP Recommended: timeCost=3, memoryCost=65536, parallelism=4

# Time cost (number of iterations)
PASSWORD_HASH_TIME_COST=3

# Memory cost in KB (65536 = 64MB)
PASSWORD_HASH_MEMORY_COST=65536

# Parallelism (number of threads)
PASSWORD_HASH_PARALLELISM=4

# ============================================
# RATE LIMITING
# ============================================

# Window duration in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# ACCOUNT LOCKOUT
# ============================================

# Number of failed login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# ============================================
# EMAIL (SMTP)
# ============================================

# SMTP server host
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# Use secure connection (true for port 465)
SMTP_SECURE=false

# SMTP authentication
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# From email address
SMTP_FROM_EMAIL=noreply@example.com

# From name (displayed in email client)
SMTP_FROM_NAME=Auth System

# ============================================
# TWO-FACTOR AUTHENTICATION
# ============================================

# Issuer name (shown in authenticator apps like Google Authenticator)
TWO_FACTOR_ISSUER=MyApp

# Encryption key for storing 2FA secrets (32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ============================================
# CORS
# ============================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# COOKIES
# ============================================

# Secure cookie (set true in production with HTTPS)
COOKIE_SECURE=false

# SameSite attribute
# Options:
#   - strict : Cookie only sent in first-party context
#   - lax    : Cookie sent with top-level navigations and GET from third-party
#   - none   : Cookie sent in all contexts (requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax

# Cookie domain (leave empty for current domain)
COOKIE_DOMAIN=localhost

# ============================================
# FRONTEND
# ============================================

# Frontend URL (for redirects, email links)
FRONTEND_URL=http://localhost:5173

# ============================================
# LOGGING
# ============================================

# Log level
# Options: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=debug

# ============================================
# OAUTH2 - GOOGLE
# ============================================
# Get credentials: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# OAUTH2 - GITHUB
# ============================================
# Get credentials: https://github.com/settings/developers

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# OAUTH2 - MICROSOFT
# ============================================
# Get credentials: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ============================================
# WEBAUTHN/PASSKEYS
# ============================================

# Relying Party ID (your domain, no protocol)
WEBAUTHN_RP_ID=localhost

# Relying Party Name (shown to users)
WEBAUTHN_RP_NAME=Enterprise Auth

# Relying Party Origin (full URL with protocol)
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# ============================================
# ROLE SIGNATURE (Admin Security)
# ============================================
# Used to cryptographically sign admin roles to prevent manipulation
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

ROLE_SIGNATURE_SECRET=your-super-secret-role-signature-key

# ============================================
# SMS NOTIFICATIONS (Twilio)
# ============================================
# Get credentials: https://console.twilio.com

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# PUSH NOTIFICATIONS (Firebase)
# ============================================
# Get credentials: https://console.firebase.google.com

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ============================================
# DOCKER / PRISMA STUDIO
# ============================================

# Prisma Studio port
PRISMA_STUDIO_PORT=5555
